{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jpeg2000_rs/legal-publication-review.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "candidate_revision",
    "scope",
    "approved_by",
    "approved_at",
    "statement"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "candidate_revision": {
      "pattern": "^sha256-tree-v1:[a-f0-9]{64}$",
      "type": "string"
    },
    "scope": {
      "const": "official-vector-use-redistribution-and-public-crate-publication"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "statement": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
