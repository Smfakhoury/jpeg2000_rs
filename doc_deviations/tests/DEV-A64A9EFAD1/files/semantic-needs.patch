+    #[test]
+    fn semantic_metadata_needs_ignore_metadata_codestream_index() {
+        // T.808 A.3.6.1: one logical target, metadata root ID 0, CSn ignored.
+        // A.3.6.3: flags=1, 8-byte OrigID and OrigBH, ordinary phld LBox.
+        let codestream = decodable_codestream();
+        let mut image_header = Vec::new();
+        image_header.extend_from_slice(&1_u32.to_be_bytes());
+        image_header.extend_from_slice(&1_u32.to_be_bytes());
+        image_header.extend_from_slice(&1_u16.to_be_bytes());
+        image_header.extend_from_slice(&[7, 7, 0, 0]);
+        let mut jp2h_payload = box32(*b"ihdr", &image_header);
+        jp2h_payload.extend(box32(*b"colr", &[1, 0, 0, 0, 0, 0, 17]));
+        let mut prefix = box32(*b"jP  ", &[0x0d, 0x0a, 0x87, 0x0a]);
+        prefix.extend(box32(*b"ftyp", b"jp2 \0\0\0\0jp2 "));
+        let suffix = box32(*b"jp2c", &codestream);
+        let mut expected_container = prefix.clone();
+        expected_container.extend(box32(*b"jp2h", &jp2h_payload));
+        expected_container.extend_from_slice(&suffix);
+        assert_eq!(&expected_container[4..8], b"jP  ");
+        assert_eq!(&expected_container[16..20], b"ftyp");
+        assert_eq!(&expected_container[20..24], b"jp2 ");
+
+        let mut violations = Vec::new();
+        for bin in [1, 127, 128, u64::from(u32::MAX) + 1, u64::MAX] {
+            let placeholder = metadata_placeholder(
+                *b"jp2h",
+                u32::try_from(jp2h_payload.len() + 8).unwrap(),
+                1,
+                bin,
+                None,
+            );
+            assert_eq!(placeholder.len(), 28);
+            assert_eq!(u32::from_be_bytes(placeholder[..4].try_into().unwrap()), 28);
+            assert_eq!(&placeholder[4..8], b"phld");
+            assert_eq!(&placeholder[8..12], &1_u32.to_be_bytes());
+            assert_eq!(&placeholder[12..20], &bin.to_be_bytes());
+            assert_eq!(&placeholder[24..28], b"jp2h");
+            let mut root = prefix.clone();
+            root.extend(placeholder);
+            root.extend_from_slice(&suffix);
+            for (root_csn, child_csn, query_csn) in
+                [(0, 0, 0), (7, 7, 7), (0, 1, 0), (0, 0, 1), (3, 5, 7)]
+            {
+                let mut cache = DatabinCache::new(ResourceLimits::default());
+                let absent = cache.assemble_semantic_container(query_csn).unwrap();
+                assert_container_dependencies(
+                    &absent,
+                    JpipAvailability::Missing,
+                    &[(JpipSemanticNeedKind::MetadataBin, 0)],
+                );
+                cache
+                    .insert(fragment(
+                        DatabinId::new(8, root_csn, 0).unwrap(),
+                        0,
+                        &root,
+                        true,
+                    ))
+                    .unwrap();
+                for complete in [false, true] {
+                    if complete {
+                        cache
+                            .insert(fragment(
+                                DatabinId::new(8, child_csn, bin).unwrap(),
+                                0,
+                                &jp2h_payload,
+                                true,
+                            ))
+                            .unwrap();
+                    }
+                    eprintln!(
+                        "route=insert(class=8)->assemble_semantic_container->semantic_needs \
+                         root_csn={root_csn} child_csn={child_csn} query_csn={query_csn} \
+                         bin={bin} complete={complete}"
+                    );
+                    let report = cache.assemble_semantic_container(query_csn).unwrap();
+                    let needs: Vec<_> = report
+                        .semantic_needs()
+                        .iter()
+                        .map(|need| (need.kind(), need.identifier()))
+                        .collect();
+                    let expected_needs = if complete {
+                        Vec::new()
+                    } else {
+                        vec![(JpipSemanticNeedKind::MetadataBin, bin)]
+                    };
+                    let actual = (
+                        report.status(),
+                        needs,
+                        report.container().map(|view| view.as_bytes()),
+                    );
+                    let expected = (
+                        if complete {
+                            JpipAvailability::Available
+                        } else {
+                            JpipAvailability::Partial
+                        },
+                        expected_needs,
+                        complete.then_some(expected_container.as_slice()),
+                    );
+                    if actual != expected {
+                        violations.push(format!(
+                            "bin={bin} root_csn={root_csn} child_csn={child_csn} \
+                             query_csn={query_csn} complete={complete}: \
+                             actual={actual:?} expected={expected:?}"
+                        ));
+                    }
+                }
+            }
+        }
+        assert!(
+            violations.is_empty(),
+            "metadata CSn must not create spurious dependencies:\n{}",
+            violations.join("\n")
+        );
     }
 
