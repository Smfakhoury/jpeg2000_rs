+    fn assert_container_dependencies(
+        report: &JpipContainerAssembly,
+        status: JpipAvailability,
+        expected: &[(JpipSemanticNeedKind, u64)],
+    ) {
+        let observed: Vec<_> = report
+            .semantic_needs()
+            .iter()
+            .map(|need| (need.kind(), need.identifier()))
+            .collect();
+        assert_eq!(observed, expected, "exact outstanding dependencies");
+        assert_eq!(report.status(), status, "dependency availability");
+        assert_eq!(
+            report.container().is_some(),
+            status == JpipAvailability::Available,
+            "incomplete data must not expose a reconstructed container"
+        );
+        assert_eq!(report.semantic_needs().len(), observed.len());
+        for (need, expected) in report.semantic_needs().iter().zip(expected) {
+            assert_eq!((need.kind(), need.identifier()), *expected);
+        }
+    }
