+    #[test]
+    fn deepspec_bounded_data_and_eor_framing() {
+        parses_end_of_response();
+        let limits = ResourceLimits::default()
+            .with_maximum_input_bytes(512)
+            .unwrap();
+        let mut seed = 0xd3_2022;
+        let mut lengths = vec![0, 1, 2, 15, 16, 126, 127, 128, 129, 255, 256];
+        lengths.extend((0..40).map(|_| (spec_random(&mut seed) % 257) as usize));
+        for length in lengths {
+            let body: Vec<_> = (0..length)
+                .map(|index| (index as u8).wrapping_mul(73))
+                .collect();
+            let fixture = SpecMessage {
+                class: 8,
+                stream: 128,
+                bin: 2048,
+                offset: 0,
+                body: body.clone(),
+                last: true,
+                auxiliary: None,
+            };
+            fixture.assert_parse(&mut JpipMessageParser::new(limits), 3, true);
+            let (data, _) = fixture.wire(3);
+            for reason in [1, 2, 3, 4, 5, 6, 7, 0xff] {
+                let mut eor = vec![0, reason];
+                eor.extend(spec_vbas(length as u64));
+                let header_length = eor.len();
+                eor.extend_from_slice(&body);
+                let consumed_expected = eor.len();
+                eor.extend_from_slice(&[0x60, 8, 0, 0, 0]);
+                let mut parser = JpipMessageParser::new(limits);
+                let (message, consumed) = parser.parse(&eor).unwrap();
+                let JpipMessage::EndOfResponse(end) = message else {
+                    panic!("D.3 EOR expected, reason={reason}, length={length}");
+                };
+                assert_eq!(end.reason_code(), reason);
+                assert_eq!(end.header_length(), header_length);
+                assert_eq!(end.body(), body);
+                assert_eq!(message.body(), body);
+                assert_eq!(end.body().as_ptr(), eor[header_length..].as_ptr());
+                assert_eq!(consumed, consumed_expected);
+                assert_eq!(parser.context(), JpipHeaderContext::new());
+                for prefix in 0..consumed_expected {
+                    assert!(
+                        matches!(
+                            parser.parse(&eor[..prefix]),
+                            Err(DecodeError::MalformedInput {
+                                kind: MalformedKind::Truncated,
+                                ..
+                            })
+                        ),
+                        "truncated EOR accepted/wrong error: reason={reason} length={length} prefix={prefix}"
+                    );
+                }
+            }
+            for prefix in 0..data.len() {
+                let mut parser = JpipMessageParser::new(limits);
+                assert!(
+                    matches!(
+                        parser.parse(&data[..prefix]),
+                        Err(DecodeError::MalformedInput {
+                            kind: MalformedKind::Truncated,
+                            ..
+                        })
+                    ),
+                    "truncated Data accepted/wrong error: length={length} prefix={prefix}"
+                );
+                assert_eq!(parser.context(), JpipHeaderContext::new());
+            }
+            for mut wire in [data, {
+                let mut eor = vec![0, 2];
+                eor.extend(spec_vbas(length as u64));
+                eor.extend_from_slice(&body);
+                eor
+            }] {
+                let limit = wire.len() as u64;
+                let exact = ResourceLimits::default()
+                    .with_maximum_input_bytes(limit)
+                    .unwrap();
+                assert_eq!(
+                    JpipMessageParser::new(exact).parse(&wire).unwrap().1,
+                    wire.len()
+                );
+                wire.push(0);
+                assert_eq!(
+                    JpipMessageParser::new(exact).parse(&wire),
+                    Err(DecodeError::LimitExceeded {
+                        resource: Resource::InputBytes,
+                        limit,
+                        actual: limit + 1,
+                    }),
+                    "whole supplied input, not only declared body, must respect limit"
+                );
+            }
+        }
+        for (offset, expected) in [(510, None), (511, Some(513))] {
+            let fixture = SpecMessage {
+                class: 8,
+                stream: 0,
+                bin: 0,
+                offset,
+                body: vec![0, 0xff],
+                last: false,
+                auxiliary: None,
+            };
+            let (wire, _) = fixture.wire(3);
+            let mut parser = JpipMessageParser::new(limits);
+            if let Some(actual) = expected {
+                assert_eq!(
+                    parser.parse(&wire),
+                    Err(DecodeError::LimitExceeded {
+                        resource: Resource::InputBytes,
+                        limit: 512,
+                        actual,
+                    })
+                );
+                assert_eq!(parser.context(), JpipHeaderContext::new());
+            } else {
+                fixture.assert_parse(&mut parser, 3, false);
+            }
+        }
+        for wire in [vec![0x60, 8, 0, 0x80, 0, 0], vec![0, 2, 0x80, 0]] {
+            let mut parser = JpipMessageParser::new(limits);
+            assert!(
+                matches!(
+                    parser.parse(&wire),
+                    Err(DecodeError::MalformedInput {
+                        kind: MalformedKind::InvalidJpipVbas,
+                        ..
+                    })
+                ),
+                "noncanonical VBAS not rejected: {wire:02x?}"
+            );
+            assert_eq!(parser.context(), JpipHeaderContext::new());
+        }
+        let overflow = SpecMessage {
+            class: 8,
+            stream: 0,
+            bin: 0,
+            offset: u64::MAX,
+            body: vec![0],
+            last: false,
+            auxiliary: None,
+        };
+        let (wire, header_length) = overflow.wire(3);
+        assert_eq!(
+            JpipMessageParser::new(limits).parse(&wire),
+            Err(DecodeError::MalformedInput {
+                offset: header_length as u64,
+                kind: MalformedKind::ArithmeticOverflow,
+            }),
+            "small input must reject overflowing declared offset+length"
+        );
+        let mut overflowing_vbas = vec![0x60, 8, 0];
+        overflowing_vbas.extend_from_slice(&[0xff; 10]);
+        overflowing_vbas.extend_from_slice(&[0x7f, 0]);
+        assert_eq!(
+            JpipMessageParser::new(limits).parse(&overflowing_vbas),
+            Err(DecodeError::MalformedInput {
+                offset: 3,
+                kind: MalformedKind::InvalidJpipVbas,
+            })
+        );
+    }
