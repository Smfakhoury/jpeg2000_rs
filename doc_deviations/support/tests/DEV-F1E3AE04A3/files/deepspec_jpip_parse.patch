+    // Independent wire model: T.808 (12/2022), A.2.1--A.2.3 and D.3.
+    // These are binary framing tests, not claims that opaque bodies decode images.
+    fn spec_vbas(value: u64) -> Vec<u8> {
+        let mut groups = vec![(value & 127) as u8];
+        let mut remaining = value >> 7;
+        while remaining != 0 {
+            groups.push(((remaining & 127) as u8) | 128);
+            remaining >>= 7;
+        }
+        groups.reverse();
+        groups
+    }
+
+    struct SpecMessage {
+        class: u64,
+        stream: u64,
+        bin: u64,
+        offset: u64,
+        body: Vec<u8>,
+        last: bool,
+        auxiliary: Option<u64>,
+    }
+
+    impl SpecMessage {
+        fn wire(&self, form: u8) -> (Vec<u8>, usize) {
+            assert!((1..=3).contains(&form));
+            assert!([0, 1, 2, 4, 5, 6, 8].contains(&self.class));
+            assert_eq!(self.auxiliary.is_some(), self.class % 2 == 1);
+            let mut tail = Vec::new();
+            let mut bin = self.bin;
+            while bin > 15 {
+                tail.push((bin & 127) as u8);
+                bin >>= 7;
+            }
+            tail.reverse();
+            let mut bytes = vec![
+                (form << 5)
+                    | if self.last { 16 } else { 0 }
+                    | bin as u8
+                    | if tail.is_empty() { 0 } else { 128 },
+            ];
+            for (index, group) in tail.iter().enumerate() {
+                bytes.push(*group | if index + 1 == tail.len() { 0 } else { 128 });
+            }
+            if form >= 2 {
+                bytes.extend(spec_vbas(self.class));
+            }
+            if form == 3 {
+                bytes.extend(spec_vbas(self.stream));
+            }
+            bytes.extend(spec_vbas(self.offset));
+            bytes.extend(spec_vbas(self.body.len() as u64));
+            if let Some(auxiliary) = self.auxiliary {
+                bytes.extend(spec_vbas(auxiliary));
+            }
+            let header_length = bytes.len();
+            bytes.extend_from_slice(&self.body);
+            (bytes, header_length)
+        }
+
+        fn assert_parse(&self, parser: &mut JpipMessageParser, form: u8, trailer: bool) {
+            let (mut wire, header_length) = self.wire(form);
+            let consumed_expected = wire.len();
+            if trailer {
+                wire.extend_from_slice(&[0, 2, 0]);
+            }
+            let (message, consumed) = parser.parse(&wire).unwrap_or_else(|error| {
+                panic!("JpipMessageParser::parse form={form} wire={wire:02x?}: {error:?}")
+            });
+            let JpipMessage::Data { header, body } = message else {
+                panic!("data framing expected: {wire:02x?}");
+            };
+            assert_eq!(header.databin().class_identifier(), self.class);
+            let class = match self.class {
+                0 | 1 => DatabinClass::Precinct,
+                2 => DatabinClass::TileHeader,
+                4 | 5 => DatabinClass::TileData,
+                6 => DatabinClass::MainHeader,
+                8 => DatabinClass::Metadata,
+                _ => unreachable!(),
+            };
+            assert_eq!(header.databin().class(), class);
+            assert_eq!(header.databin().codestream(), self.stream);
+            assert_eq!(header.databin().in_class(), self.bin);
+            assert_eq!(header.offset(), self.offset);
+            assert_eq!(header.length(), self.body.len() as u64);
+            assert_eq!(header.is_last_byte(), self.last);
+            assert_eq!(
+                header.final_length(),
+                self.last.then_some(self.offset + self.body.len() as u64)
+            );
+            assert_eq!(header.auxiliary(), self.auxiliary);
+            assert_eq!(header.header_length(), header_length);
+            assert_eq!(consumed, consumed_expected);
+            assert_eq!(body, self.body);
+            assert_eq!(message.body(), self.body);
+            assert_eq!(body.as_ptr(), wire[header_length..].as_ptr());
+            assert_eq!(parser.context().previous_class(), Some(self.class));
+            assert_eq!(parser.context().previous_codestream(), Some(self.stream));
+        }
+    }
+
+    fn spec_random(seed: &mut u64) -> u64 {
+        *seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        *seed >> 17
+    }
