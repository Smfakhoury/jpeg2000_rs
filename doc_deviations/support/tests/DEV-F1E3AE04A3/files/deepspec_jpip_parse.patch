+    #[test]
+    fn deepspec_parser_local_inheritance_lifecycle() {
+        let limits = ResourceLimits::default()
+            .with_maximum_input_bytes(512)
+            .unwrap();
+        let mut parser = JpipMessageParser::new(limits);
+        let mut other = JpipMessageParser::new(limits);
+        assert_eq!(parser.context(), JpipHeaderContext::new());
+        let isolated = SpecMessage {
+            class: 8,
+            stream: 999,
+            bin: 16,
+            offset: 1,
+            body: vec![0xff],
+            last: false,
+            auxiliary: None,
+        };
+        isolated.assert_parse(&mut other, 3, false);
+        assert_eq!(parser.context(), JpipHeaderContext::new());
+        let mut seed = 0xa2_2022;
+        let mut class = 8;
+        let mut stream = 128;
+        for index in 0..160 {
+            let form = if index == 0 { 3 } else { 1 + (index % 3) as u8 };
+            if form >= 2 {
+                class = [0, 1, 2, 4, 5, 6, 8][(spec_random(&mut seed) % 7) as usize];
+            }
+            if form == 3 {
+                stream = spec_random(&mut seed) % 65536;
+            }
+            let fixture = SpecMessage {
+                class,
+                stream,
+                bin: 0,
+                offset: index as u64,
+                body: vec![index as u8, 0xff],
+                last: index % 2 == 0,
+                auxiliary: (class % 2 == 1).then_some(1),
+            };
+            fixture.assert_parse(&mut parser, form, false);
+            let snapshot = parser.context();
+            assert_eq!(snapshot.previous_class(), Some(class));
+            assert_eq!(snapshot.previous_codestream(), Some(stream));
+            assert_eq!(other.context().previous_class(), Some(8));
+            assert_eq!(other.context().previous_codestream(), Some(999));
+            isolated.assert_parse(&mut other, 1, false);
+
+            let replacement = SpecMessage {
+                class: if class == 8 { 6 } else { 8 },
+                stream: stream + 1,
+                bin: 0,
+                offset: 0,
+                body: vec![1, 2, 3],
+                last: true,
+                auxiliary: None,
+            };
+            let (wire, header_length) = replacement.wire(3);
+            for prefix in 0..wire.len() {
+                assert!(
+                    matches!(
+                        parser.parse(&wire[..prefix]),
+                        Err(DecodeError::MalformedInput {
+                            kind: MalformedKind::Truncated,
+                            ..
+                        })
+                    ),
+                    "failed explicit header must not commit; prefix={prefix} header={header_length}"
+                );
+                assert_eq!(
+                    parser.context(),
+                    snapshot,
+                    "context changed after prefix={prefix}"
+                );
+            }
+            assert!(matches!(
+                parser.parse(&[1, 0, 0]),
+                Err(DecodeError::MalformedInput {
+                    kind: MalformedKind::InvalidJpipHeader,
+                    ..
+                })
+            ));
+            assert_eq!(parser.context(), snapshot);
+            let oversized = SpecMessage {
+                offset: 511,
+                ..replacement
+            };
+            let (wire, _) = oversized.wire(3);
+            assert_eq!(
+                parser.parse(&wire),
+                Err(DecodeError::LimitExceeded {
+                    resource: Resource::InputBytes,
+                    limit: 512,
+                    actual: 514,
+                })
+            );
+            assert_eq!(parser.context(), snapshot);
+            let mut invalid = vec![0x60, oversized.class as u8];
+            invalid.extend(spec_vbas(oversized.stream));
+            invalid.extend_from_slice(&[0x80, 0, 0]);
+            assert!(matches!(
+                parser.parse(&invalid),
+                Err(DecodeError::MalformedInput {
+                    kind: MalformedKind::InvalidJpipVbas,
+                    ..
+                })
+            ));
+            assert_eq!(parser.context(), snapshot);
+            assert_eq!(
+                parser.parse(&[0; 513]),
+                Err(DecodeError::LimitExceeded {
+                    resource: Resource::InputBytes,
+                    limit: 512,
+                    actual: 513,
+                })
+            );
+            assert_eq!(parser.context(), snapshot);
+            fixture.assert_parse(&mut parser, 1, true);
+            assert_eq!(snapshot.previous_class(), Some(class));
+            assert_eq!(snapshot.previous_codestream(), Some(stream));
+        }
+        let snapshot = parser.context();
+        let (message, consumed) = parser.parse(&[0, 2, 2, 0x80, 0xff]).unwrap();
+        assert!(matches!(message, JpipMessage::EndOfResponse(_)));
+        assert_eq!(message.body(), [0x80, 0xff]);
+        assert_eq!(consumed, 5);
+        assert_eq!(
+            parser.context(),
+            snapshot,
+            "EOR must not replace inherited identifiers"
+        );
+    }
