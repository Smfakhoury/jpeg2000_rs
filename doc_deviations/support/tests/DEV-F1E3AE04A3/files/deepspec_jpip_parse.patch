+    #[test]
+    fn deepspec_standard_header_forms() {
+        parses_all_three_standard_header_forms_and_auxiliary();
+        let limits = ResourceLimits::default();
+        let mut seed = 0x808_2022;
+        let boundaries = [0, 1, 15, 16, 127, 128, 2047, 2048, 16383, 16384];
+        for value in boundaries {
+            let fixture = SpecMessage {
+                class: 8,
+                stream: value,
+                bin: value,
+                offset: value,
+                body: vec![0x80],
+                last: false,
+                auxiliary: None,
+            };
+            fixture.assert_parse(&mut JpipMessageParser::new(limits), 3, true);
+        }
+        for index in 0..160 {
+            let class = [0, 1, 2, 4, 5, 6, 8][index % 7];
+            let value = if index < boundaries.len() {
+                boundaries[index]
+            } else {
+                spec_random(&mut seed) % 65536
+            };
+            let fixture = SpecMessage {
+                class,
+                stream: value,
+                bin: if class == 8 { value } else { 0 },
+                offset: value,
+                body: vec![0, 0xff, 0x80],
+                last: index % 2 == 0,
+                auxiliary: (class % 2 == 1).then_some(1),
+            };
+            fixture.assert_parse(&mut JpipMessageParser::new(limits), 3, true);
+            let mut parser = JpipMessageParser::new(limits);
+            fixture.assert_parse(&mut parser, 3, false);
+            fixture.assert_parse(&mut parser, 1, true);
+            fixture.assert_parse(&mut parser, 2, false);
+            let initial_class_only = SpecMessage {
+                stream: 0,
+                ..fixture
+            };
+            initial_class_only.assert_parse(&mut JpipMessageParser::new(limits), 2, false);
+        }
+        for first in [0x01, 0x10, 0x81] {
+            let mut parser = JpipMessageParser::new(limits);
+            assert_eq!(
+                parser.parse(&[first, 0, 0]),
+                Err(DecodeError::MalformedInput {
+                    offset: 0,
+                    kind: MalformedKind::InvalidJpipHeader,
+                }),
+                "A.2.1 prohibits indicator bb=00; first={first:#x}"
+            );
+            assert_eq!(parser.context(), JpipHeaderContext::new());
+        }
+
+        // A.2.1 defines zero defaults, NOT an InvalidJpipHeader rejection.
+        // The minimal first message names precinct 0, offset 0, length 0.
+        let mut failures = Vec::new();
+        for bin in [0, 1, 15, 16, 127, 128] {
+            for last in [false, true] {
+                let fixture = SpecMessage {
+                    class: 0,
+                    stream: 0,
+                    bin,
+                    offset: 0,
+                    body: Vec::new(),
+                    last,
+                    auxiliary: None,
+                };
+                let (wire, _) = fixture.wire(1);
+                let mut parser = JpipMessageParser::new(limits);
+                match parser.parse(&wire) {
+                    Ok(_) => fixture.assert_parse(&mut JpipMessageParser::new(limits), 1, false),
+                    Err(error) => failures.push(format!("first inherited {wire:02x?}: {error:?}")),
+                }
+            }
+        }
+        assert!(
+            failures.is_empty(),
+            "A.2.1 zero defaults violated:\n{}",
+            failures.join("\n")
+        );
+    }
