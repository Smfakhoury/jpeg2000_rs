+    #[test]
+    fn databin_view_metadata_identity_ignores_codestream() {
+        // T.808 (12/2022) A.3.6.1: one logical target per cache, root bin 0,
+        // and metadata made of family-file boxes. No transport header is fabricated.
+        let expected = box32(*b"free", b"metadata identity");
+        assert_eq!(
+            u32::from_be_bytes(expected[..4].try_into().unwrap()) as usize,
+            expected.len()
+        );
+        assert_eq!(&expected[4..8], b"free");
+        let mut failures = Vec::new();
+        for (stored_stream, other_stream) in
+            [(0, 1), (1, 0), (127, 128), (128, 16383), (16384, u64::MAX)]
+        {
+            let root = DatabinId::new(8, stored_stream, 0).unwrap();
+            let root_alias = DatabinId::new(8, other_stream, 0).unwrap();
+            assert_eq!(root.class(), DatabinClass::Metadata);
+            assert_eq!(root.in_class(), 0);
+            assert_ne!(stored_stream, other_stream);
+
+            let mut cache = DatabinCache::new(ResourceLimits::default());
+            assert_eq!(
+                cache.databin_view(root_alias),
+                Err(DecodeError::malformed(
+                    0,
+                    MalformedKind::MissingRequiredStructure
+                ))
+            );
+            cache.insert(fragment(root, 0, &expected, true)).unwrap();
+            assert_eq!(cache.databin_view(root).unwrap().as_bytes(), expected);
+            let actual = cache.databin_view(root_alias).map(JpipByteView::into_bytes);
+            if actual != Ok(expected.clone()) {
+                failures.push(format!(
+                    "complete root: stored CSn={stored_stream}, queried CSn={other_stream}, \
+                     expected={expected:?}, actual={actual:?}"
+                ));
+            }
+            let distinct_bin = DatabinId::new(8, other_stream, 1).unwrap();
+            assert_eq!(
+                cache.databin_view(distinct_bin),
+                Err(DecodeError::malformed(
+                    0,
+                    MalformedKind::MissingRequiredStructure
+                ))
+            );
+            let distinct_class = DatabinId::new(4, other_stream, 0).unwrap();
+            assert_eq!(
+                cache.databin_view(distinct_class),
+                Err(DecodeError::malformed(
+                    0,
+                    MalformedKind::MissingRequiredStructure
+                ))
+            );
+
+            let mut empty = DatabinCache::new(ResourceLimits::default());
+            empty.insert(fragment(root, 0, b"", true)).unwrap();
+            let actual = empty.databin_view(root_alias).map(JpipByteView::into_bytes);
+            if actual != Ok(Vec::new()) {
+                failures.push(format!(
+                    "empty root: stored CSn={stored_stream}, queried CSn={other_stream}, actual={actual:?}"
+                ));
+            }
+
+            for bin in [0, 1, 15, 16, 127, 128] {
+                let first = DatabinId::new(8, stored_stream, bin).unwrap();
+                let second = DatabinId::new(8, other_stream, bin).unwrap();
+                let mut mixed = DatabinCache::new(ResourceLimits::default());
+                if bin != 0 {
+                    mixed.insert(fragment(root, 0, b"", true)).unwrap();
+                }
+                let middle = expected.len() / 2;
+                mixed
+                    .insert(fragment(second, middle as u64, &expected[middle..], true))
+                    .unwrap();
+                for query in [first, second] {
+                    assert_eq!(
+                        mixed.databin_view(query),
+                        Err(DecodeError::malformed(
+                            0,
+                            MalformedKind::MissingRequiredStructure
+                        )),
+                        "incomplete metadata: bin={bin}, query={query:?}"
+                    );
+                }
+                mixed
+                    .insert(fragment(first, 0, &expected[..middle], false))
+                    .unwrap();
+                for query in [first, second] {
+                    let actual = mixed.databin_view(query).map(JpipByteView::into_bytes);
+                    if actual != Ok(expected.clone()) {
+                        failures.push(format!(
+                            "mixed fragments: bin={bin}, CSns={stored_stream}/{other_stream}, \
+                             query={query:?}, expected={expected:?}, actual={actual:?}"
+                        ));
+                    }
+                }
+            }
+        }
+        // The metadata exception must not collapse codestream-specific data-bins.
+        for class in [0, 2, 4, 6] {
+            let first = DatabinId::new(class, 0, 0).unwrap();
+            let second = DatabinId::new(class, 1, 0).unwrap();
+            let mut cache = DatabinCache::new(ResourceLimits::default());
+            cache.insert(fragment(first, 0, b"first", true)).unwrap();
+            assert_eq!(
+                cache.databin_view(second),
+                Err(DecodeError::malformed(
+                    0,
+                    MalformedKind::MissingRequiredStructure
+                ))
+            );
+            cache.insert(fragment(second, 0, b"second", true)).unwrap();
+            assert_eq!(cache.databin_view(first).unwrap().as_bytes(), b"first");
+            assert_eq!(cache.databin_view(second).unwrap().as_bytes(), b"second");
+        }
+        assert!(
+            failures.is_empty(),
+            "insert -> databin_view violates metadata CSn independence:\n{}",
+            failures
+                .iter()
+                .take(8)
+                .cloned()
+                .collect::<Vec<_>>()
+                .join("\n")
+        );
     }
 
