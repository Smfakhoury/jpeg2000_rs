+    fn databin_view_full_coverage_sweep() {
+        let mut seed = 0x6a09_e667_f3bc_c909_u64;
+        let limits = ResourceLimits::default()
+            .with_maximum_input_bytes(256)
+            .unwrap();
+        for class in [0, 2, 4, 6, 8] {
+            for length in [0, 1, 2, 3, 7, 8, 15, 16, 31, 32, 63, 64, 127, 128, 255, 256] {
+                let target = id(class, 0);
+                let expected: Vec<u8> = (0..length)
+                    .map(|_| {
+                        seed ^= seed << 13;
+                        seed ^= seed >> 7;
+                        seed ^= seed << 17;
+                        seed as u8
+                    })
+                    .collect();
+                let check = |cache: &DatabinCache, covered: &[bool], final_known: bool| {
+                    let prefix = covered.iter().take_while(|&&present| present).count();
+                    let actual = cache.databin_view(target).map(JpipByteView::into_bytes);
+                    let wanted = if final_known && prefix == length {
+                        Ok(expected.clone())
+                    } else {
+                        Err(DecodeError::malformed(
+                            prefix as u64,
+                            MalformedKind::MissingRequiredStructure,
+                        ))
+                    };
+                    assert_eq!(
+                        actual, wanted,
+                        "insert -> databin_view: class={class}, length={length}, \
+                         prefix={prefix}, final_known={final_known}, covered={covered:?}"
+                    );
+                };
+
+                let mut cache = DatabinCache::new(limits);
+                check(&cache, &vec![false; length], false);
+                if length > 0 {
+                    cache.insert(fragment(target, 0, &expected, false)).unwrap();
+                }
+                check(&cache, &vec![true; length], false);
+                cache
+                    .insert(fragment(target, length as u64, b"", true))
+                    .unwrap();
+                check(&cache, &vec![true; length], true);
+
+                // A last-byte indication establishes length, not coverage (T.808 A.2.1).
+                let mut cache = DatabinCache::new(limits);
+                cache
+                    .insert(fragment(target, length as u64, b"", true))
+                    .unwrap();
+                let mut covered = vec![false; length];
+                check(&cache, &covered, true);
+                let mut order: Vec<usize> = (0..length).collect();
+                for index in (1..length).rev() {
+                    seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    order.swap(index, (seed % (index as u64 + 1)) as usize);
+                }
+                for index in order {
+                    cache
+                        .insert(fragment(
+                            target,
+                            index as u64,
+                            &expected[index..index + 1],
+                            false,
+                        ))
+                        .unwrap();
+                    covered[index] = true;
+                    check(&cache, &covered, true);
+                }
+                cache.insert(fragment(target, 0, &expected, true)).unwrap();
+                check(&cache, &covered, true);
+                if length > 0 {
+                    cache.insert(fragment(target, 0, &expected, false)).unwrap();
+                }
+                check(&cache, &covered, true);
+
+                if length == 0 {
+                    continue;
+                }
+                for hole in [0, length / 2, length - 1] {
+                    let mut cache = DatabinCache::new(limits);
+                    cache
+                        .insert(fragment(
+                            target,
+                            (hole + 1) as u64,
+                            &expected[hole + 1..],
+                            true,
+                        ))
+                        .unwrap();
+                    if hole > 0 {
+                        cache
+                            .insert(fragment(target, 0, &expected[..hole], false))
+                            .unwrap();
+                    }
+                    let mut covered = vec![true; length];
+                    covered[hole] = false;
+                    check(&cache, &covered, true);
+                    cache
+                        .insert(fragment(
+                            target,
+                            hole as u64,
+                            &expected[hole..hole + 1],
+                            false,
+                        ))
+                        .unwrap();
+                    covered[hole] = true;
+                    check(&cache, &covered, true);
+                }
+            }
+        }
+    }
