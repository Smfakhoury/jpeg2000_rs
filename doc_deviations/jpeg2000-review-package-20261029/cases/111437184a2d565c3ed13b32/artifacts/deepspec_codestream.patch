--- a/src/jp2.rs
+++ b/src/jp2.rs
@@ -3952,6 +3952,139 @@
                 ..
             })
         ));
+
+        // T.801 M.11.6: top-level jpch i describes jp2c i, and H=0 or H=N.
+        // Use the real grayscale fixture, not the empty-tile framing helper.
+        fn association_fixture(
+            streams: usize,
+            headers: usize,
+        ) -> (Vec<u8>, Vec<Vec<u8>>, Vec<Vec<u8>>, Vec<usize>, Vec<usize>) {
+            let gray = include_bytes!("../validation/image-consumer-probe/tests/fixtures/gray.jp2");
+            assert_eq!(gray.len(), 167);
+            assert_eq!(&gray[32..40], b"\0\0\0-jp2h");
+            assert_eq!(&gray[40..48], b"\0\0\0\x16ihdr");
+            assert_eq!(&gray[48..62], &[0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 7, 7, 0, 0]);
+            assert_eq!(&gray[62..77], b"\0\0\0\x0fcolr\x01\0\0\0\0\0\x11");
+            assert_eq!(&gray[77..87], b"\0\0\0Zjp2c\xff\x4f");
+            assert_eq!(&gray[87..91], b"\xff\x51\0\x29");
+            assert_eq!(&gray[150..152], b"\xff\x90");
+            assert_eq!(&gray[gray.len() - 2..], b"\xff\xd9");
+
+            let mut bytes = box32(*b"jP  ", &SIGNATURE_MAGIC);
+            bytes.extend(box32(*b"ftyp", b"jpx \0\0\0\0jpx "));
+            // M.11.1: one rreq immediately after ftyp; feature 1 (Part 1,
+            // no codestream extensions), one-byte masks, no vendor features.
+            bytes.extend(box32(*b"rreq", &[1, 128, 128, 0, 1, 0, 1, 128, 0, 0]));
+            bytes.extend(box32(*b"jp2h", &gray[40..77]));
+            let mut header_payloads = Vec::new();
+            let mut header_offsets = Vec::new();
+            for index in 0..headers {
+                let mut payload = gray[40..62].to_vec();
+                // M.11.13 labels are UTF-8, unpadded and not NUL terminated.
+                payload.extend(box32(*b"lbl ", format!("stream-{index}").as_bytes()));
+                header_offsets.push(bytes.len());
+                bytes.extend(box32(*b"jpch", &payload));
+                header_payloads.push(payload);
+            }
+            // One layer, default registration to stream 0 and inherited gray
+            // color (M.11.7); other streams need not be rendered.
+            bytes.extend(box32(*b"jplh", &[]));
+            let mut stream_payloads = Vec::new();
+            let mut stream_offsets = Vec::new();
+            for index in 0..streams {
+                let mut payload = gray[85..150].to_vec();
+                let mut comment = vec![0, 1];
+                comment.extend_from_slice(format!("stream-{index}").as_bytes());
+                payload.extend(marker_segment(0xff64, &comment));
+                payload.extend_from_slice(&gray[150..]);
+                stream_offsets.push(bytes.len());
+                bytes.extend(box32(*b"jp2c", &payload));
+                stream_payloads.push(payload);
+            }
+            (bytes, stream_payloads, header_payloads, stream_offsets, header_offsets)
+        }
+
+        let limits = ResourceLimits::default();
+        assert_eq!(limits.maximum_codestreams(), 64);
+        let mut counts = vec![1, 2, 3, 7, 31, 63, 64];
+        let mut seed = 0x8841_0e65_u32;
+        for _ in 0..8 {
+            seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            counts.push(4 + (seed as usize % 59));
+        }
+        counts.sort_unstable();
+        counts.dedup();
+        for count in counts {
+            for explicit in [false, true] {
+                let headers = if explicit { count } else { 0 };
+                let (bytes, streams, payloads, stream_offsets, header_offsets) =
+                    association_fixture(count, headers);
+                assert!(bytes.len() as u64 <= limits.maximum_input_bytes());
+                assert!(bytes.len() as u64 <= limits.maximum_metadata_bytes());
+                eprintln!("88410e65: parse -> Jp2File::codestream; N={count}, H={headers}");
+                let file = parse(&bytes, &limits).expect("standards-grounded JPX must be admitted");
+                assert_eq!(file.file_type().brand, BoxType::JPX_BRAND);
+                assert!(file.file_type().is_jpx_compatible());
+                assert_eq!(file.codestream_count(), count);
+                assert_eq!(file.codestreams().len(), count);
+                for index in 0..count {
+                    let stream = file.codestream(index).unwrap();
+                    assert_eq!(stream.data(), streams[index], "stream ordinal {index}");
+                    assert_eq!(stream.box_header().offset(), stream_offsets[index] as u64);
+                    assert_eq!(stream.box_header().box_type(), BoxType::CONTIGUOUS_CODESTREAM);
+                    if explicit {
+                        let association = stream.codestream_header().unwrap_or_else(|| {
+                            panic!("N={count}, H={headers}: stream {index} lost its header")
+                        });
+                        assert_eq!(association.payload(), payloads[index], "header ordinal {index}");
+                        assert_eq!(association.box_header().offset(), header_offsets[index] as u64);
+                        assert_eq!(association.box_header().box_type(), BoxType::CODESTREAM_HEADER);
+                        let image = association.parsed_header().unwrap().image;
+                        assert_eq!((image.width, image.height, image.components), (1, 1, 1));
+                    } else {
+                        assert!(stream.codestream_header().is_none());
+                        assert_eq!(
+                            associated_header_for_codestream(stream, file.header()).unwrap(),
+                            file.header()
+                        );
+                    }
+                }
+                assert_eq!(
+                    file.codestream(count),
+                    Err(DecodeError::CodestreamIndexOutOfRange {
+                        index: count,
+                        codestreams: count,
+                    })
+                );
+            }
+        }
+
+        let mut admitted_mismatches = Vec::new();
+        for (streams, headers) in [
+            (1, 2), (2, 3), (7, 8), (63, 64),
+            (2, 1), (3, 2), (8, 7), (64, 63), (64, 1),
+        ] {
+            let (bytes, _, _, _, _) = association_fixture(streams, headers);
+            eprintln!("88410e65: cardinality rejection; N={streams}, H={headers}");
+            match parse(&bytes, &limits) {
+                Err(DecodeError::MalformedInput { .. }) => {}
+                Err(error) => panic!("N={streams}, H={headers}: unrelated rejection: {error:?}"),
+                Ok(file) => {
+                    let missing: Vec<_> = (0..streams)
+                        .filter(|&index| file.codestream(index).unwrap().codestream_header().is_none())
+                        .collect();
+                    admitted_mismatches.push(format!(
+                        "N={streams}, H={headers}: admitted {} streams, missing headers at {missing:?}",
+                        file.codestream_count()
+                    ));
+                }
+            }
+        }
+        assert!(
+            admitted_mismatches.is_empty(),
+            "T.801 M.11.6 forbids nonzero cardinality mismatches:\n{}",
+            admitted_mismatches.join("\n")
+        );
     }
 
     #[test]
