{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jpeg2000_rs/support-matrix.schema.json",
  "title": "jpeg2000_rs support matrix",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_status",
    "implementation_status",
    "approval",
    "claims",
    "standards",
    "decode",
    "unsupported",
    "errors",
    "resource_limits",
    "release_gates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_status": {
      "enum": [
        "proposed",
        "approved",
        "retired"
      ]
    },
    "implementation_status": {
      "enum": [
        "not_started",
        "in_progress",
        "complete"
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "approved",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "approved": {
          "type": "boolean"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "claims": {
      "type": "object"
    },
    "standards": {
      "type": "object"
    },
    "decode": {
      "type": "object"
    },
    "unsupported": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resource_limits": {
      "type": "object"
    },
    "release_gates": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
