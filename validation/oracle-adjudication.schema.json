{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jpeg2000_rs/oracle-adjudication.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "validation_result_sha256",
    "summary",
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "passed",
        "blocked",
        "skipped"
      ]
    },
    "validation_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "external_oracles_available",
        "total",
        "unadjudicated",
        "adjudicated"
      ],
      "properties": {
        "external_oracles_available": {
          "type": "integer",
          "minimum": 0
        },
        "external_observations": {
          "type": "integer",
          "minimum": 0
        },
        "external_oracle_errors": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unadjudicated": {
          "type": "integer",
          "minimum": 0
        },
        "adjudicated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "case_id",
          "oracle",
          "kind",
          "subject_sha256",
          "oracle_sha256",
          "status",
          "decision",
          "rationale",
          "adjudicator",
          "adjudicated_at"
        ],
        "properties": {
          "id": {
            "pattern": "^oracle-disagreement-v1:[a-f0-9]{64}$",
            "type": "string"
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "acceptance",
              "normalized-output"
            ]
          },
          "subject_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "oracle_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "unadjudicated",
              "adjudicated"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "adjudicator": {
            "type": [
              "string",
              "null"
            ]
          },
          "adjudicated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "adjudicated"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "decision": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudicator": {
                  "type": "string",
                  "minLength": 1
                },
                "adjudicated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
