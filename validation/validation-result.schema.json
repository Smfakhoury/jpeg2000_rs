{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "corpus_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "disagreements": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    },
    "oracles": {
      "type": "array"
    },
    "profile_id": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": ["git_commit", "git_dirty", "source_revision", "source_hashes", "tool_hashes", "python"]
    },
    "oracle_errors": {
      "type": "array"
    },
    "oracle_config_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "provenance",
    "oracle_errors",
    "corpus_manifest_sha256",
    "oracles",
    "summary",
    "failures",
    "disagreements",
    "records"
  ],
  "type": "object"
}
