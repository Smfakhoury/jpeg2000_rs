{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "budgets": {
      "type": "object"
    },
    "cases": {
      "type": "array"
    },
    "profile_id": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": ["git_commit", "git_dirty", "source_revision", "source_hashes", "tool_hashes", "python", "subject_binary_sha256"]
    },
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "provenance",
    "budgets",
    "summary",
    "cases"
  ],
  "type": "object"
}
