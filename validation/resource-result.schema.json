{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "scope", "provenance", "status", "blockers", "errors", "tools", "address_space_limit_bytes", "file_size_limit_bytes", "output_limit_bytes", "declaration", "accounting_declaration", "accounting_declaration_sha256", "accounting_records", "remaining_r1_gaps", "qualification_failures", "repetitions", "records", "native_total_ms", "native_user_cpu_ms", "native_system_cpu_ms", "native_total_cpu_ms", "maximum_native_total_ms", "maximum_selection_rss_ratio", "subject_build"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 5},
    "scope": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}
      }
    },
    "address_space_limit_bytes": {"const": 1073741824},
    "file_size_limit_bytes": {"const": 33554432},
    "output_limit_bytes": {"const": 16777216},
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "baseline_cases", "workloads", "rejections"],
      "properties": {
        "id": {"const": "r1-safe-production-v1"},
        "baseline_cases": {"const": 22},
        "workloads": {
          "type": "array", "minItems": 10, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "width", "height", "components", "precision", "tile_size", "layers", "high_throughput", "modes"],
            "properties": {
              "id": {"enum": ["large-gray", "components8", "precision24", "tiles256", "layers16", "ht-large", "jpx-components", "jpx-compose", "jpip-fragments", "jpip-ht-fragments"]},
              "width": {"type": "integer", "minimum": 1, "maximum": 1536},
              "height": {"type": "integer", "minimum": 1, "maximum": 1536},
              "components": {"enum": [1, 3, 8]},
              "precision": {"enum": [8, 16, 24]},
              "tile_size": {"enum": [32, 128, 256]},
              "layers": {"enum": [1, 16]},
              "high_throughput": {"type": "boolean"},
              "modes": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
                        "items": {"enum": ["full", "tile0", "native2"]}}
            }
          }
        },
        "rejections": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "resource", "limit", "actual"],
            "properties": {
              "id": {"type": "string"},
              "resource": {"$ref": "#/$defs/resource"},
              "limit": {"type": "integer", "minimum": 0},
              "actual": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "accounting_declaration_sha256": {"const": "cc25a51fec71019cd8cfe8a2418b441d0d27214c2a46328ed89b16e3fc79d1f4"},
    "accounting_declaration": {"const": {
      "id": "r1-effective-frontiers-v2", "baseline_cases": 45,
      "paths": [
        {"id": "selected-raw", "family": "selected", "operation": "select", "format": "raw", "size": 32, "components": 1, "precision": 8, "tile_size": 16, "decomposition_levels": 2, "output_protocol": "selected-image", "output_components": 1},
        {"id": "selected-color", "family": "selected-color", "operation": "select-color", "format": "jp2", "size": 32, "components": 3, "precision": 16, "tile_size": 16, "decomposition_levels": 2, "output_protocol": "image", "output_components": 3},
        {"id": "jpx-compose", "family": "composition", "operation": "render", "format": "jpx", "size": 16, "components": 3, "precision": 16, "tile_size": 16, "decomposition_levels": 2, "output_protocol": "image", "composited_layers": 2, "output_components": 4},
        {"id": "jpip-reconstruct", "family": "jpip", "operation": "reconstruct", "format": "jpip", "size": 16, "components": 3, "precision": 16, "tile_size": 16, "decomposition_levels": 2, "output_protocol": "reconstructed-image", "output_components": 3},
        {"id": "jpip-progressive", "family": "jpip", "operation": "progressive", "format": "auto", "size": 16, "components": 1, "precision": 8, "tile_size": 16, "decomposition_levels": 0, "output_protocol": "progressive", "expected_updates": 7, "output_components": 1}
      ],
      "ceilings": {"DecodedBytes": 1048576, "WorkUnits": 100000}, "maximum_search_probes": 32
    }},
    "accounting_records": {
      "type": "array", "maxItems": 20,
      "items": {"allOf": [
        {"$ref": "#/$defs/record"},
        {"properties": {
          "accounting_path": {"type": "string"},
          "configured_limit": {"$ref": "#/$defs/limit"},
          "qualifications": {"minItems": 1},
          "expected_output_sha256": {"$ref": "#/$defs/hash"}
        }}
      ]}
    },
    "remaining_r1_gaps": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "qualification_failures": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "error", "artifacts"],
        "properties": {"id": {"type": "string", "minLength": 1}, "error": {"type": "string", "minLength": 1},
                       "artifacts": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "repetitions": {"const": 3},
    "native_total_ms": {"type": "number", "minimum": 0},
    "native_user_cpu_ms": {"type": "number", "minimum": 0},
    "native_system_cpu_ms": {"type": "number", "minimum": 0},
    "native_total_cpu_ms": {"type": "number", "minimum": 0},
    "maximum_native_total_ms": {"const": 30000.0},
    "maximum_selection_rss_ratio": {"const": 0.75},
    "subject_build": {"enum": ["provided", "cargo-release"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
    "then": {"properties": {
      "tools": {"required": ["encoder", "decoder", "time", "subject", "ht_encoder", "ht_decoder"]},
      "blockers": {"maxItems": 0},
      "errors": {"maxItems": 0},
      "qualification_failures": {"maxItems": 0},
      "accounting_records": {
        "minItems": 20, "maxItems": 20,
        "items": {"properties": {"status": {"const": "passed"}}},
        "contains": {"properties": {"search_ceiling": {"type": "integer"}}, "required": ["search_ceiling"]},
        "minContains": 10, "maxContains": 10
      },
      "records": {
        "minItems": 45, "maxItems": 45,
        "items": {"properties": {"status": {"const": "passed"}}},
        "contains": {"properties": {"search_ceiling": {"type": "integer"}}, "required": ["search_ceiling"]},
        "minContains": 4, "maxContains": 4
      }
    }, "allOf": [{"properties": {"accounting_records": {
      "contains": {"properties": {"expected_category": {"const": "LimitExceeded"}}, "required": ["expected_category"]},
      "minContains": 10, "maxContains": 10
    }}}, {"properties": {"records": {
      "contains": {
        "properties": {"configured_limit": {"type": "object"}, "expected_category": {"const": "LimitExceeded"}},
        "required": ["configured_limit", "expected_category"]
      },
      "minContains": 4, "maxContains": 4
    }}}]}
  }],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource": {"enum": ["DecodedBytes", "WorkUnits", "Width", "Height", "Components", "Tiles", "Layers", "Codestreams", "InputBytes", "Pixels"]},
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["resource", "limit", "actual"],
      "properties": {
        "resource": {"$ref": "#/$defs/resource"},
        "limit": {"type": "integer", "minimum": 0},
        "actual": {"type": "integer", "minimum": 1}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["original_output_sha256", "reference_output_sha256", "payload_sha256", "source_files", "reference_files"],
      "properties": {
        "original_output_sha256": {"$ref": "#/$defs/hash"},
        "reference_output_sha256": {"$ref": "#/$defs/hash"},
        "payload_sha256": {"$ref": "#/$defs/hash"},
        "source_files": {"$ref": "#/$defs/files"},
        "reference_files": {"$ref": "#/$defs/files"}
      }
    },
    "files": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
        "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}
      }
    },
    "limit": {
      "type": "object", "additionalProperties": false, "required": ["resource", "value"],
      "properties": {
        "resource": {"enum": ["DecodedBytes", "WorkUnits"]},
        "value": {"type": "integer", "minimum": 0}
      }
    },
    "observed-error": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "reason", "diagnostic"],
      "properties": {
        "category": {"enum": ["LimitExceeded", "MalformedInput"]},
        "reason": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "diagnostic": {"type": "string", "minLength": 1}
      },
      "allOf": [{
        "if": {"properties": {"category": {"const": "LimitExceeded"}}, "required": ["category"]},
        "then": {"properties": {
          "reason": {"$ref": "#/$defs/resource"},
          "diagnostic": {"pattern": "^ERR\\tLimitExceeded\\tresource limit exceeded for [A-Za-z][A-Za-z0-9]*: limit [0-9]+, actual [0-9]+$"}
        }}
      }, {
        "if": {"properties": {"category": {"const": "MalformedInput"}}, "required": ["category"]},
        "then": {"properties": {
          "diagnostic": {"pattern": "^ERR\\tMalformedInput\\tmalformed input at byte [0-9]+: [A-Za-z][A-Za-z0-9]*$"}
        }}
      }]
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["elapsed_ms", "peak_rss_bytes", "user_cpu_ms", "system_cpu_ms", "total_cpu_ms", "returncode", "output_sha256"],
      "properties": {
        "elapsed_ms": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 1},
        "user_cpu_ms": {"type": "number", "minimum": 0},
        "system_cpu_ms": {"type": "number", "minimum": 0},
        "total_cpu_ms": {"type": "number", "minimum": 0},
        "reconstructed_sha256": {"$ref": "#/$defs/hash"},
        "returncode": {"enum": [0, 1]},
        "output_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "limit_value": {"type": "integer", "minimum": 0},
        "limit_claim": {"$ref": "#/$defs/claim"},
        "observed_error": {"$ref": "#/$defs/observed-error"},
        "protocol_sha256": {"$ref": "#/$defs/hash"},
        "progressive_updates": {
          "type": "array", "maxItems": 7, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "previous_layers", "available_layers", "image_present", "missing_ranges", "output_sha256"],
            "properties": {
              "status": {"enum": ["WaitingForData", "Complete"]},
              "previous_layers": {"enum": [0, 1]},
              "available_layers": {"enum": [0, 1]},
              "image_present": {"type": "boolean"},
              "missing_ranges": {"type": "integer", "minimum": 0},
              "output_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
            },
            "allOf": [{
              "if": {"properties": {"image_present": {"const": true}}, "required": ["image_present"]},
              "then": {"properties": {"output_sha256": {"$ref": "#/$defs/hash"}}},
              "else": {"properties": {"output_sha256": {"type": "null"}}}
            }]
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"returncode": {"const": 0}}, "required": ["returncode"]},
        "then": {"properties": {"output_sha256": {"$ref": "#/$defs/hash"}},
                 "not": {"anyOf": [{"required": ["limit_claim"]}, {"required": ["observed_error"]}]}}
      }, {
        "if": {"properties": {"returncode": {"const": 1}}, "required": ["returncode"]},
        "then": {"required": ["observed_error"], "properties": {"output_sha256": {"type": "null"}}}
      }, {
        "if": {"required": ["observed_error"], "properties": {
          "observed_error": {"properties": {"category": {"const": "LimitExceeded"}}, "required": ["category"]}
        }},
        "then": {"required": ["limit_claim"]}
      }, {
        "if": {"required": ["observed_error"], "properties": {
          "observed_error": {"properties": {"category": {"const": "MalformedInput"}}, "required": ["category"]}
        }},
        "then": {"not": {"required": ["limit_claim"]}}
      }]
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "accounting_path", "command", "output_protocol", "progressive_updates_expected", "input_bytes", "input_sha256", "expected_category", "expected_reason", "expected_output_sha256", "qualifications", "expected_reconstructed_sha256", "expected_limit_claim", "limit_mode", "mode", "typed_sample_bytes", "output_width", "output_height", "output_components", "thresholds", "runs", "status", "error", "artifacts", "configured_limit", "search_ceiling", "search_runs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "accounting_path": {"enum": [null, "selected-raw", "selected-color", "jpx-compose", "jpip-reconstruct", "jpip-progressive"]},
        "command": {"type": "array", "minItems": 4, "maxItems": 9, "items": {"type": "string", "minLength": 1}},
        "output_protocol": {"enum": ["image", "selected-image", "reconstructed-image", "progressive"]},
        "progressive_updates_expected": {"enum": [null, 7]},
        "input_bytes": {"type": "integer", "minimum": 1},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "expected_category": {"enum": [null, "LimitExceeded", "MalformedInput"]},
        "expected_reason": {"type": ["string", "null"]},
        "expected_output_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "qualifications": {"type": "array", "items": {"$ref": "#/$defs/qualification"}},
        "expected_reconstructed_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "expected_limit_claim": {"anyOf": [{"$ref": "#/$defs/claim"}, {"type": "null"}]},
        "limit_mode": {"enum": ["production-default", "single-tightened-defaults"]},
        "mode": {"enum": ["full", "selection", "rejection"]},
        "typed_sample_bytes": {"type": "integer", "minimum": 0},
        "output_width": {"type": "integer", "minimum": 0},
        "output_height": {"type": "integer", "minimum": 0},
        "output_components": {"type": "integer", "minimum": 0},
        "configured_limit": {"anyOf": [{"$ref": "#/$defs/limit"}, {"type": "null"}]},
        "search_ceiling": {"type": ["integer", "null"], "minimum": 1},
        "search_runs": {
          "type": "array", "maxItems": 32,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/measurement"},
              {"required": ["limit_value"]},
              {
                "if": {"properties": {"returncode": {"const": 1}}, "required": ["returncode"]},
                "then": {"required": ["limit_claim"], "properties": {
                  "observed_error": {"properties": {"category": {"const": "LimitExceeded"}}}
                }}
              }
            ]
          }
        },
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["maximum_ms", "maximum_peak_rss_bytes"],
          "properties": {
            "maximum_ms": {"type": "number", "exclusiveMinimum": 0},
            "maximum_peak_rss_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/measurement"}
        },
        "status": {"enum": ["passed", "failed"]},
        "error": {"type": ["string", "null"]},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "median_ms": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 1},
        "selection_full_rss_ratio": {"type": "number", "minimum": 0},
        "amplification": {
          "type": "object", "additionalProperties": false,
          "required": ["typed_sample_bytes_per_input_byte", "peak_rss_per_typed_sample_byte"],
          "properties": {
            "typed_sample_bytes_per_input_byte": {"type": "number", "exclusiveMinimum": 0},
            "peak_rss_per_typed_sample_byte": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"output_protocol": {"const": "progressive"}}, "required": ["output_protocol"]},
        "then": {"properties": {
          "progressive_updates_expected": {"const": 7},
          "runs": {"items": {"required": ["progressive_updates", "protocol_sha256"]}},
          "search_runs": {"items": {"required": ["progressive_updates", "protocol_sha256"]}}
        }},
        "else": {"properties": {"progressive_updates_expected": {"type": "null"}}}
      }, {
        "if": {"properties": {"id": {"const": "declared-pixel-limit"}}, "required": ["id"]},
        "then": {"properties": {
          "expected_category": {"const": "LimitExceeded"},
          "expected_reason": {"const": "Pixels"},
          "configured_limit": {"type": "null"},
          "expected_limit_claim": {"const": {"resource": "Pixels", "limit": 100000000, "actual": 4294836225}},
          "runs": {"items": {"properties": {
            "observed_error": {"properties": {
              "category": {"const": "LimitExceeded"}, "reason": {"const": "Pixels"},
              "diagnostic": {"const": "ERR\tLimitExceeded\tresource limit exceeded for Pixels: limit 100000000, actual 4294836225"}
            }},
            "limit_claim": {"const": {"resource": "Pixels", "limit": 100000000, "actual": 4294836225}}
          }}}
        }}
      }, {
        "if": {"properties": {"expected_category": {"const": "LimitExceeded"}}, "required": ["expected_category"]},
        "then": {"properties": {
          "expected_reason": {"$ref": "#/$defs/resource"},
          "runs": {"items": {"properties": {
            "observed_error": {"properties": {"category": {"const": "LimitExceeded"}}}
          }}}
        }}
      }, {
        "if": {"properties": {"expected_category": {"const": "MalformedInput"}}, "required": ["expected_category"]},
        "then": {"properties": {
          "expected_reason": {"const": "Truncated"},
          "runs": {"items": {"properties": {
            "observed_error": {"properties": {
              "category": {"const": "MalformedInput"}, "reason": {"const": "Truncated"},
              "diagnostic": {"pattern": "^ERR\\tMalformedInput\\tmalformed input at byte [0-9]+: Truncated$"}
            }}
          }}}
        }}
      }, {
        "if": {"properties": {"mode": {"const": "full"}}, "required": ["mode"]},
        "then": {"properties": {"thresholds": {"properties": {
          "maximum_ms": {"const": 5000.0}, "maximum_peak_rss_bytes": {"const": 536870912}
        }}}}
      }, {
        "if": {"properties": {"mode": {"const": "selection"}}, "required": ["mode"]},
        "then": {"properties": {"thresholds": {"properties": {
          "maximum_ms": {"const": 2500.0}, "maximum_peak_rss_bytes": {"const": 268435456}
        }}}}
      }, {
        "if": {"properties": {"mode": {"const": "rejection"}}, "required": ["mode"]},
        "then": {"properties": {"thresholds": {"properties": {
          "maximum_ms": {"const": 1000.0}, "maximum_peak_rss_bytes": {"const": 134217728}
        }}}}
      }, {
        "if": {"properties": {"search_ceiling": {"type": "integer"}}, "required": ["search_ceiling"]},
        "then": {"properties": {"configured_limit": {
                   "allOf": [{"$ref": "#/$defs/limit"}, {"properties": {"value": {"minimum": 1}}}]
                 }},
                 "allOf": [{
                   "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
                   "then": {"properties": {"search_runs": {"minItems": 2}}}
                 }]},
        "else": {"properties": {"search_runs": {"maxItems": 0}}}
      }, {
        "if": {"properties": {"configured_limit": {"type": "object"}, "expected_category": {"type": "string"}},
               "required": ["configured_limit", "expected_category"]},
        "then": {"properties": {
          "expected_category": {"const": "LimitExceeded"},
          "expected_reason": {"enum": ["DecodedBytes", "WorkUnits"]},
          "runs": {"items": {"required": ["limit_claim"]}}
        }}
      }, {
        "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
        "then": {"required": ["median_ms", "peak_rss_bytes"], "properties": {
          "runs": {"minItems": 3, "maxItems": 3}, "error": {"type": "null"}, "artifacts": {"maxItems": 0}
        }}
      }, {
        "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
        "then": {"properties": {"error": {"type": "string", "minLength": 1}, "artifacts": {"minItems": 1}}}
      }, {
        "if": {"properties": {"expected_category": {"type": "null"}}, "required": ["expected_category"]},
        "then": {"properties": {
          "expected_output_sha256": {"$ref": "#/$defs/hash"},
          "qualifications": {"minItems": 1},
          "runs": {"items": {"properties": {"returncode": {"const": 0}, "output_sha256": {"$ref": "#/$defs/hash"}}}}
        }}
      }, {
        "if": {"properties": {"expected_category": {"type": "string"}}, "required": ["expected_category"]},
        "then": {"properties": {"runs": {"items": {"properties": {
          "returncode": {"const": 1}, "output_sha256": {"type": "null"}
        }}}}}
      }]
    }
  }
}
