{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jpeg2000_rs/release-attestation.schema.json",
  "title": "jpeg2000_rs release evidence attestation",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_type",
    "status",
    "immutable_source_revision",
    "profile_id",
    "tool_revision",
    "input_hashes",
    "result",
    "commands",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "attestation_type": {
      "enum": [
        "proof",
        "conformance",
        "fuzz",
        "performance",
        "package-audit",
        "release"
      ]
    },
    "status": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "immutable_source_revision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256-tree-v1:[a-f0-9]{64}$"
        }
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    },
    "bindings": {
      "type": "object",
      "required": [
        "source",
        "toolchains",
        "proof",
        "corpus",
        "validation",
        "budgets",
        "adjudication",
        "architecture",
        "approvals"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/pathList"
        },
        "toolchains": {
          "$ref": "#/$defs/pathList"
        },
        "proof": {
          "$ref": "#/$defs/pathList"
        },
        "corpus": {
          "$ref": "#/$defs/pathList"
        },
        "validation": {
          "$ref": "#/$defs/pathList"
        },
        "budgets": {
          "$ref": "#/$defs/pathList"
        },
        "fuzz": {
          "$ref": "#/$defs/pathList"
        },
        "profile": {
          "$ref": "#/$defs/pathList"
        },
        "package": {
          "$ref": "#/$defs/pathList"
        },
        "adjudication": {
          "$ref": "#/$defs/pathList"
        },
        "architecture": {
          "$ref": "#/$defs/pathList"
        },
        "approvals": {
          "$ref": "#/$defs/pathList"
        },
        "results": {
          "$ref": "#/$defs/pathList"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "official_vectors",
        "oracle_adjudication",
        "architecture",
        "proof_boundary",
        "legal_publication",
        "owner_approval"
      ],
      "properties": {
        "official_vectors": {
          "$ref": "#/$defs/officialVectorGate"
        },
        "oracle_adjudication": {
          "$ref": "#/$defs/adjudicationGate"
        },
        "architecture": {
          "$ref": "#/$defs/gate"
        },
        "proof_boundary": {
          "$ref": "#/$defs/gate"
        },
        "legal_publication": {
          "$ref": "#/$defs/gate"
        },
        "owner_approval": {
          "$ref": "#/$defs/gate"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/pathList"
        }
      },
      "additionalProperties": true
    },
    "officialVectorGate": {
      "allOf": [
        {
          "$ref": "#/$defs/gate"
        },
        {
          "type": "object",
          "required": [
            "vector_count",
            "selection_complete",
            "executed",
            "passed",
            "failed",
            "manifest_sha256",
            "archive_sha256",
            "result_sha256"
          ],
          "properties": {
            "vector_count": {
              "type": "integer",
              "minimum": 0
            },
            "selection_complete": {
              "type": "boolean"
            },
            "executed": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "manifest_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "archive_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "adjudicationGate": {
      "allOf": [
        {
          "$ref": "#/$defs/gate"
        },
        {
          "type": "object",
          "required": [
            "unresolved",
            "external_oracles_available"
          ],
          "properties": {
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "external_oracles_available": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attestation_type": {
            "const": "release"
          }
        },
        "required": [
          "attestation_type"
        ]
      },
      "then": {
        "required": [
          "bindings",
          "gates"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "immutable_source_revision": {
            "type": "string",
            "pattern": "^sha256-tree-v1:[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attestation_type": {
            "const": "release"
          },
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "attestation_type",
          "status"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "official_vectors": {
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "vector_count": {
                    "minimum": 1
                  },
                  "selection_complete": {
                    "const": true
                  },
                  "failed": {
                    "const": 0
                  },
                  "manifest_sha256": {
                    "type": "string"
                  },
                  "archive_sha256": {
                    "type": "string"
                  }
                }
              },
              "oracle_adjudication": {
                "properties": {
                  "status": {
                    "const": "passed"
                  },
                  "unresolved": {
                    "const": 0
                  },
                  "external_oracles_available": {
                    "minimum": 1
                  }
                }
              },
              "architecture": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "proof_boundary": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "legal_publication": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "owner_approval": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            }
          },
          "result": {
            "required": [
              "publish_allowed",
              "official_conformance_claimed"
            ],
            "properties": {
              "publish_allowed": {
                "const": true
              },
              "official_conformance_claimed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
