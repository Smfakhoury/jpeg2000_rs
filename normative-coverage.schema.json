{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical reference inventory (not exhaustive clause coverage)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "requirements"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "scope": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "topic", "implementation_refs", "spec_refs",
          "contract_refs", "proof_refs", "test_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "implementation_refs": {"$ref": "#/$defs/references"},
          "spec_refs": {"$ref": "#/$defs/references"},
          "contract_refs": {"$ref": "#/$defs/references"},
          "proof_refs": {"$ref": "#/$defs/references"},
          "test_refs": {"$ref": "#/$defs/references"}
        }
      }
    }
  },
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol"],
        "properties": {
          "path": {"type": "string", "pattern": "^(src|specs|proofs)/[A-Za-z0-9_./-]+\\.rs$"},
          "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_:]*$"}
        }
      }
    }
  }
}
